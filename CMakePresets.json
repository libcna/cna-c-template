  "testPresets": [
    {
      "name": "sdlgpu",
      "configurePreset": "sdlgpu",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "label": "display"
