      "binaryDir": "${sourceDir}/build-sdl-renderer",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "SDL_RENDERER"
      },
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Linux",
          "Windows",
          "Darwin"
        ]
      }
    },
    {
