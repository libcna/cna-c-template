{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "web-base",
      "hidden": true,
      "inherits": "release",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Linux",
          "Windows",
          "Darwin"
        ]
      }
    },
    {
      "name": "mingw-base",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-w64.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "sdlgpu",
      "displayName": "SDLGPU \u2014 CNA's default on Windows, macOS and iOS",
      "description": "2D3D renderer. Platforms: linux, windows, macos. Dependency: none.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-sdlgpu",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "SDLGPU"
      },
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Linux",
          "Windows",
          "Darwin"
        ]
      }
    },
    {
      "name": "opengles3",
      "displayName": "OPENGLES3 \u2014 CNA's default on Linux, Android and other non-web targets",
      "description": "2D3D renderer. Platforms: linux, windows, macos, android. Dependency: sibling ../easy-gl (which needs ../meta-gl).",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-opengles3",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "OPENGLES3"
      },
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Linux",
          "Windows",
          "Darwin"
        ]
      }
    },
    {
      "name": "opengl33",
      "displayName": "OPENGL33 \u2014 Internally EasyGL, desktop GL 3.3 core profile",
      "description": "2D3D renderer. Platforms: linux, windows, macos. Dependency: sibling ../easy-gl (which needs ../meta-gl).",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-opengl33",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "OPENGL33"
      },
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Linux",
          "Windows",
          "Darwin"
        ]
      }
    },
    {
      "name": "web-webgl2",
      "displayName": "WEBGL2 \u2014 CNA's default renderer under Emscripten",
      "description": "2D3D renderer. Platforms: web. Dependency: sibling ../easy-gl (which needs ../meta-gl).",
      "inherits": "web-base",
      "binaryDir": "${sourceDir}/build-web-webgl2",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "WEBGL2"
      },
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Linux",
          "Windows",
          "Darwin"
        ]
      }
    },
    {
      "name": "webgpu",
      "displayName": "WEBGPU \u2014 Native wgpu-native on desktop",
      "description": "2D3D renderer. Platforms: linux, windows, macos, web. Dependency: wgpu-native binary release, auto-downloaded.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-webgpu",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "WEBGPU"
      },
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Linux",
          "Windows",
          "Darwin"
        ]
      }
    },
    {
      "name": "headless",
      "displayName": "HEADLESS \u2014 No GPU and no window at all",
      "description": "2D3D renderer. Platforms: linux, windows, macos, android. Dependency: none.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-headless",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "HEADLESS"
      },
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Linux",
          "Windows",
          "Darwin"
        ]
      }
    },
    {
      "name": "software",
      "displayName": "SOFTWARE \u2014 Real CPU rasterizer",
      "description": "2D3D renderer. Platforms: linux, windows, macos, android. Dependency: none.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-software",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "SOFTWARE"
      },
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Linux",
          "Windows",
          "Darwin"
        ]
      }
    },
    {
      "name": "stub",
      "displayName": "STUB \u2014 Deliberate no-op renderer",
      "description": "2D3D renderer. Platforms: linux, windows, macos, android. Dependency: none.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-stub",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "STUB"
      },
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Linux",
          "Windows",
          "Darwin"
        ]
      }
    },
    {
      "name": "fna3d",
      "displayName": "FNA3D \u2014 The XNA-shaped C library FNA renders through",
      "description": "2D3D renderer. Platforms: linux, windows, macos. Dependency: FNA3D + MojoShader via FetchContent; needs Python3.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-fna3d",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "FNA3D"
      },
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Linux",
          "Windows",
          "Darwin"
        ]
      }
    },
    {
      "name": "directx9",
      "displayName": "DIRECTX9 \u2014 Direct3D 9",
      "description": "2D3D renderer. Platforms: windows. Dependency: d3d9.h.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-directx9",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "DIRECTX9"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-directx9",
      "displayName": "DIRECTX9 \u2014 Direct3D 9",
      "description": "2D3D renderer. Platforms: windows. Dependency: d3d9.h.",
      "inherits": "mingw-base",
      "binaryDir": "${sourceDir}/build-windows-directx9",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "DIRECTX9"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
