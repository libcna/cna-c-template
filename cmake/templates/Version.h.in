/*
 * CnaTemplate/Version.h -- the cna-c-template release a translation unit is compiled against.
 *
 * Generated by cmake/CnaTemplateVersion.cmake from cmake/templates/Version.h.in. The version
 * itself is decided in one place only: project(CnaTemplate VERSION ...) and
 * CNA_TEMPLATE_VERSION_PRERELEASE in the root CMakeLists.txt (see docs/releasing.md). Never edit
 * the generated copy in the build tree.
 *
 * This is the template's (your game's) own version. The CNA release underneath has its own
 * (CNA::getVersionString() in C++), and the CNA C ABI has a third, CNA_ABI_VERSION_* in
 * CNA/C/abi.h, which is the binary contract this game is compiled against. The three move
 * independently.
 */
#ifndef CNA_TEMPLATE_VERSION_H
#define CNA_TEMPLATE_VERSION_H

/* Major component of the release, as a preprocessor-testable integer literal. */
#define CNA_TEMPLATE_VERSION_MAJOR @PROJECT_VERSION_MAJOR@

/* Minor component of the release, as a preprocessor-testable integer literal. */
#define CNA_TEMPLATE_VERSION_MINOR @PROJECT_VERSION_MINOR@

/* Patch component of the release, as a preprocessor-testable integer literal. */
#define CNA_TEMPLATE_VERSION_PATCH @PROJECT_VERSION_PATCH@

/* Pre-release identifier without its leading '-'; an empty string on a final release. */
#define CNA_TEMPLATE_VERSION_PRERELEASE "@CNA_TEMPLATE_VERSION_PRERELEASE@"

/* The complete release string, e.g. "0.1.0" or "0.2.0-beta.1"; no leading 'v'. */
#define CNA_TEMPLATE_VERSION_STRING "@CNA_TEMPLATE_VERSION_STRING@"

#ifdef __cplusplus
extern "C" {
#endif

/* The complete release string in Semantic Versioning spelling, e.g. "0.1.0". */
static inline const char* cna_template_version_string(void) { return CNA_TEMPLATE_VERSION_STRING; }

/* The pre-release identifier ("beta.1" for 0.2.0-beta.1); "" on a final release. */
static inline const char* cna_template_version_prerelease(void) { return CNA_TEMPLATE_VERSION_PRERELEASE; }

/* 1 for an alpha, beta or release-candidate build, 0 on a final release. */
static inline int cna_template_version_is_prerelease(void) { return CNA_TEMPLATE_VERSION_PRERELEASE[0] != '\0'; }

#ifdef __cplusplus
}
#endif

#endif /* CNA_TEMPLATE_VERSION_H */
